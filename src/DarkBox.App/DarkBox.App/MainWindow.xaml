<Window x:Class="DarkBox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:DarkBox.App.Views"
        xmlns:vm="clr-namespace:DarkBox.App.ViewModels"
        mc:Ignorable="d"
        Title="DarkBox"
        Height="720"
        Width="1100"
        MinHeight="540"
        MinWidth="820"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Background="{StaticResource BackgroundBrush}"
        Icon="pack://application:,,,/DarkBox;component/Assets/DarkBoxIcon.ico">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:UnlockViewModel}">
            <views:UnlockView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VaultViewModel}">
            <views:VaultView />
        </DataTemplate>
    </Window.Resources>

    <ContentControl Content="{Binding CurrentViewModel}" />
</Window>
