<UserControl x:Class="DarkBox.App.Views.SplashScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Border Width="450"
                Height="350"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="40">
                <Image Source="pack://application:,,,/DarkBox;component/Assets/DarkBoxIcon.png"
                       Width="80"
                       Height="80"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20" />

                <TextBlock Text="DarkBox"
                           FontSize="32"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8" />

                <TextBlock Text="FreezeezyPeak"
                           FontSize="16"
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30" />

                <TextBlock Text="Gestor Privado de Contraseñas"
                           FontSize="14"
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30" />

                <Grid Margin="0,0,0,20">
                    <ProgressBar Value="{Binding ProgressValue}"
                                 Minimum="0"
                                 Maximum="100"
                                 Height="6"
                                 Width="300"
                                 HorizontalAlignment="Center"
                                 Style="{StaticResource ModernProgressBar}" />

                    <TextBlock Text="{Binding ProgressText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="0,12,0,0" />
                </Grid>

                <TextBlock Text="{Binding StatusMessage}"
                           HorizontalAlignment="Center"
                           FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="350" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
