<UserControl x:Class="DarkBox.App.Views.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:DarkBox.App.Behaviors">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo y título -->
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/DarkBox;component/Assets/DarkBoxIcon.png"
                           Width="42"
                           Height="42"
                           Stretch="Uniform" />
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DarkBox" 
                                   FontSize="22" 
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding Username, StringFormat='Bóveda de {0}'}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="13" />
                    </StackPanel>
                </StackPanel>

                <!-- Botón Bloquear -->
                <Button Grid.Column="1"
                        Content="Bloquear"
                        Command="{Binding LockCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        VerticalAlignment="Center"
                        Padding="16,8"
                        FontSize="13" />
            </Grid>
        </Border>

        <!-- Contenido principal -->
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Lista de credenciales -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="0">
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          GridLinesVisibility="None"
                          RowBackground="Transparent"
                          AlternatingRowBackground="{StaticResource SurfaceLightBrush}"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Servicio" 
                                           Binding="{Binding Service}" 
                                           Width="2.5*"
                                           HeaderStyle="{StaticResource ModernDataGridHeader}"
                                           ElementStyle="{StaticResource ModernDataGridCell}" />
                        <DataGridTextColumn Header="Usuario" 
                                           Binding="{Binding Username}" 
                                           Width="2.5*"
                                           HeaderStyle="{StaticResource ModernDataGridHeader}"
                                           ElementStyle="{StaticResource ModernDataGridCell}" />
                        <DataGridTemplateColumn Header="Contraseña" 
                                               Width="2*"
                                               HeaderStyle="{StaticResource ModernDataGridHeader}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource ModernDataGridCell}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource PasswordDisplay}">
                                                    <Binding Path="Password" />
                                                    <Binding Path="DataContext.ArePasswordsVisible"
                                                             RelativeSource="{RelativeSource AncestorType=DataGrid}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="URL" 
                                           Binding="{Binding Url}" 
                                           Width="3*"
                                           HeaderStyle="{StaticResource ModernDataGridHeader}"
                                           ElementStyle="{StaticResource ModernDataGridCell}" />
                        <DataGridTextColumn Header="Actualizado" 
                                           Binding="{Binding UpdatedLocalText}" 
                                           Width="1.2*"
                                           HeaderStyle="{StaticResource ModernDataGridHeader}"
                                           ElementStyle="{StaticResource ModernDataGridCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Separador -->
            <GridSplitter Grid.Column="1"
                         Width="1"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Stretch"
                         Background="{StaticResource BorderBrush}"
                         ShowsPreview="True" />

            <!-- Editor de credenciales -->
            <Border Grid.Column="2"
                    Margin="20,0,0,0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24"
                    Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Título del editor -->
                        <TextBlock Text="{Binding EditorTitle}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,20" />

                        <!-- Campos de edición -->
                        <StackPanel>
                            <!-- Servicio y Usuario -->
                            <Grid Margin="0,0,0,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" 
                                           Text="Servicio *" 
                                           FontWeight="SemiBold"
                                           FontSize="14" />
                                <TextBlock Grid.Row="0" Grid.Column="2" 
                                           Text="Usuario" 
                                           FontWeight="SemiBold"
                                           FontSize="14" />
                                
                                <TextBox Grid.Row="1" Grid.Column="0"
                                         Text="{Binding EditorService, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,6,0,0"
                                         Padding="12,8"
                                         FontSize="14" />
                                <TextBox Grid.Row="1" Grid.Column="2"
                                         Text="{Binding EditorUsername, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,6,0,0"
                                         Padding="12,8"
                                         FontSize="14" />
                            </Grid>

                            <!-- Contraseña -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="Contraseña *" 
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Grid.Column="0" />
                                
                                <Button Content="{Binding EditorPasswordToggleText}"
                                        Command="{Binding ToggleEditorPasswordVisibilityCommand}"
                                        Style="{StaticResource LinkButtonStyle}"
                                        Grid.Column="1"
                                        Padding="6,0"
                                        FontSize="12" />
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <PasswordBox behaviors:PasswordBoxHelper.BindPassword="True"
                                             behaviors:PasswordBoxHelper.BoundPassword="{Binding EditorPassword, Mode=TwoWay}"
                                             Visibility="{Binding IsEditorPasswordVisible, Converter={StaticResource InverseBoolToVisibility}}"
                                             Padding="12,8"
                                             FontSize="14" />
                                <TextBox Text="{Binding EditorPassword, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding IsEditorPasswordVisible, Converter={StaticResource BoolToVisibility}}"
                                         Padding="12,8"
                                         FontSize="14" />
                            </Grid>

                            <!-- URL -->
                            <TextBlock Text="URL" 
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Margin="0,0,0,6" />
                            <TextBox Text="{Binding EditorUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,16"
                                     Padding="12,8"
                                     FontSize="14" />

                            <!-- Notas -->
                            <TextBlock Text="Notas" 
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Margin="0,0,0,6" />
                            <TextBox Text="{Binding EditorNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Height="80"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,24"
                                     Padding="12,8"
                                     FontSize="14" />

                            <!-- Botones de acción -->
                            <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Right">
                                <Button Content="Cancelar"
                                        Command="{Binding CancelEditCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="20,10"
                                        FontSize="13"
                                        Margin="0,0,12,0" />
                                <Button Content="Guardar"
                                        Command="{Binding SaveCommand}"
                                        Padding="20,10"
                                        FontSize="13" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Barra de herramientas y mensajes -->
        <Border Grid.Row="2"
                Margin="0,20,0,0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Botones principales -->
                <WrapPanel Grid.Row="0"
                           HorizontalAlignment="Left">
                    <Button Content="Nueva Credencial"
                            Command="{Binding NewItemCommand}"
                            IsEnabled="{Binding IsNotBusy}"
                            Padding="16,10"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="0,0,12,0" />
                    
                    <Button Content="Editar Seleccionada"
                            Command="{Binding EditSelectedCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="{Binding IsNotBusy}"
                            Padding="16,10"
                            FontSize="13"
                            Margin="0,0,12,0" />
                    
                    <Button Content="Eliminar"
                            Command="{Binding DeleteSelectedCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            IsEnabled="{Binding IsNotBusy}"
                            Padding="16,10"
                            FontSize="13"
                            Margin="0,0,12,0" />
                </WrapPanel>

                <!-- Botones secundarios -->
                <WrapPanel Grid.Row="0"
                           HorizontalAlignment="Right">
                    <Button Content="Copiar Usuario"
                            Command="{Binding CopyUsernameCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="{Binding IsNotBusy}"
                            Padding="12,8"
                            FontSize="12"
                            Margin="0,0,8,0" />
                    
                    <Button Content="Copiar Contraseña"
                            Command="{Binding CopyPasswordCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="{Binding IsNotBusy}"
                            Padding="12,8"
                            FontSize="12"
                            Margin="0,0,8,0" />
                    
                    <Button Content="{Binding PasswordVisibilityButtonText}"
                            Command="{Binding TogglePasswordVisibilityCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="{Binding IsNotBusy}"
                            Padding="12,8"
                            FontSize="12"
                            Margin="0,0,8,0" />
                    
                    <Button Content="Exportar PDF"
                            Command="{Binding ExportAllToPdfCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="{Binding IsNotBusy}"
                            Padding="12,8"
                            FontSize="12"
                            Margin="0,0,0,0" />
                </WrapPanel>

                <!-- Mensajes de estado -->
                <StackPanel Grid.Row="1" 
                            Margin="0,12,0,0">
                    <TextBlock Text="{Binding StatusMessage}"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVisibility}}"
                               Foreground="{StaticResource SuccessBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4" />
                    
                    <TextBlock Text="{Binding ErrorMessage}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVisibility}}"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="13"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
