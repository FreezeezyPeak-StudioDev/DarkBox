<UserControl x:Class="DarkBox.App.Views.UnlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:DarkBox.App.Behaviors">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Border Width="480"
                Height="580"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="20">
            <StackPanel Margin="40,30"
                        IsEnabled="{Binding IsNotBusy}">
                
                <!-- Logo y título -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <Image Source="pack://application:,,,/DarkBox;component/Assets/DarkBoxLogin.png"
                           Width="64"
                           Height="64"
                           Stretch="Uniform"
                           Grid.Column="0"
                           Margin="0,0,20,0" />
                    
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Text="DarkBox"
                                   FontSize="28"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding ModeTitle}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>

                <Separator Margin="0,24,0,24" 
                           Background="{StaticResource BorderBrush}" 
                           Height="1" />

                <!-- Campos de entrada -->
                <StackPanel>
                    <TextBlock Text="Usuario" 
                               FontWeight="SemiBold" 
                               FontSize="14" />
                    <TextBox x:Name="UsernameBox"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,8,0,20"
                             Padding="12,8"
                             FontSize="14" />

                    <TextBlock Text="Contraseña maestra" 
                               FontWeight="SemiBold" 
                               FontSize="14" />
                    <PasswordBox behaviors:PasswordBoxHelper.BindPassword="True"
                                 behaviors:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay}"
                                 Margin="0,8,0,20"
                                 Padding="12,8"
                                 FontSize="14" />

                    <StackPanel Visibility="{Binding IsCreateMode, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,0,0,20">
                        <TextBlock Text="Confirmar contraseña maestra" 
                                   FontWeight="SemiBold" 
                                   FontSize="14" />
                        <PasswordBox behaviors:PasswordBoxHelper.BindPassword="True"
                                     behaviors:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay}"
                                     Margin="0,8,0,8"
                                     Padding="12,8"
                                     FontSize="14" />
                        <TextBlock Text="Mínimo 12 caracteres. No hay recuperación si la olvidas."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"
                               FontSize="12" />
                </StackPanel>

                <!-- Botones -->
                <StackPanel Margin="0,20,0,0">
                    <Button Content="{Binding SubmitButtonText}"
                            Command="{Binding SubmitCommand}"
                            IsDefault="True"
                            HorizontalAlignment="Stretch"
                            Padding="20,12"
                            FontSize="14"
                            FontWeight="SemiBold" />

                    <Button Content="{Binding ToggleModeText}"
                            Command="{Binding ToggleModeCommand}"
                            Style="{StaticResource LinkButtonStyle}"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0"
                            Padding="8,4" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
