<UserControl x:Class="DarkBox.App.Views.UnlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:DarkBox.App.Behaviors"
             Loaded="OnLoaded">
    <Grid Background="{StaticResource BackgroundBrush}">
        <StackPanel Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsEnabled="{Binding IsNotBusy}">
            <Image Source="pack://application:,,,/DarkBox;component/Assets/DarkBoxLoginClose.png"
                   Width="150"
                   Height="132"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Border Width="36"
                        Height="36"
                        CornerRadius="10"
                        Background="{StaticResource SurfaceAltBrush}">
                    <Image Source="pack://application:,,,/DarkBox;component/Assets/FreezeezyPeakLogo.png"
                           Width="28"
                           Height="28"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="10,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="DarkBox"
                               FontSize="24"
                               FontWeight="Bold" />
                    <TextBlock Text="by FreezeezyPeak"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{Binding ModeTitle}"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,12" />

            <Separator Height="1"
                       Background="{StaticResource BorderBrush}"
                       Margin="0,0,0,14" />

            <TextBlock Text="Usuario"
                       FontWeight="SemiBold"
                       FontSize="13" />
            <TextBox x:Name="UsernameBox"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="32"
                     Margin="0,6,0,12"
                     Padding="10,7"
                     FontSize="13" />

            <TextBlock Text="Contraseña maestra"
                       FontWeight="SemiBold"
                       FontSize="13" />
            <PasswordBox behaviors:PasswordBoxHelper.BindPassword="True"
                         behaviors:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay}"
                         MaxLength="1024"
                         Margin="0,6,0,12"
                         Padding="10,7"
                         FontSize="13" />

            <StackPanel Visibility="{Binding IsCreateMode, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,0,12">
                <TextBlock Text="Confirmar contraseña maestra"
                           FontWeight="SemiBold"
                           FontSize="13" />
                <PasswordBox behaviors:PasswordBoxHelper.BindPassword="True"
                             behaviors:PasswordBoxHelper.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay}"
                             MaxLength="1024"
                             Margin="0,6,0,6"
                             Padding="10,7"
                             FontSize="13" />
                <TextBlock Text="Mínimo 12 caracteres. No hay recuperación si la olvidas."
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="10"
                           TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       FontSize="12" />

            <Button Content="{Binding SubmitButtonText}"
                    Command="{Binding SubmitCommand}"
                    IsDefault="True"
                    HorizontalAlignment="Stretch"
                    Padding="18,10"
                    FontSize="13"
                    FontWeight="SemiBold" />

            <Button Content="{Binding ToggleModeText}"
                    Command="{Binding ToggleModeCommand}"
                    Style="{StaticResource LinkButtonStyle}"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0"
                    Padding="8,3" />

            <TextBlock Text="Cifrado local · AES-256-GCM"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
